{
  "agents": {
    "defaults": {
      "workspace": "${WORKSPACE}",
      "model": "mimo-v2.5-pro",
      "provider": "custom",
      "maxTokens": 4096,
      "temperature": 0.3,
      "timezone": "Asia/Shanghai",
      "botName": "Nexus客服",
      "botIcon": "💬",
      "idleCompactAfterMinutes": 15,
      "unifiedSession": false,
      "dream": {
        "enabled": false
      }
    }
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": false,
    "showReasoning": false,
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "mode": "polling",
      "allowFrom": ["7504241670"],
      "replyToMessage": true,
      "inlineKeyboards": false,
      "streaming":false,
      "reactEmoji": "",
      "connectionPoolSize": 64,
      "poolTimeout": 20
    },
    "feishu": {
      "enabled": false,
      "appId": "",
      "appSecret": ""
    },
    "dingtalk": {
      "enabled": false,
      "appKey": "",
      "appSecret": ""
    }
  },
  "providers": {
    "custom": {
      "apiKey": "${NEXUS_API_KEY}",
      "apiBase": "${NEXUS_API_BASE}",
      "apiType": "auto",
      "extraHeaders": null,
      "extraBody": null
    },
    "anthropic": {
      "apiKey": ""
    },
    "openrouter": {
      "apiKey": ""
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {
      "enable": false,
      "timeout": 30,
      "pathAppend": ""
    },
    "mcpServers": {
      "ticket": {
        "command": "${WORKSPACE}/.venv/bin/python",
        "args": ["${WORKSPACE}/mcp_servers/ticket_server.py"],
        "enabledTools": [
          "create_ticket",
          "query_ticket",
          "update_ticket",
          "list_tickets"
        ],
        "toolTimeout": 30
      }
    }
  },
  "gateway": {
    "heartbeat": {
      "enabled": false
    }
  }
}
